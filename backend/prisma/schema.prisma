// Prisma schema for the Store Rating System.
//
// Design notes:
// - Role is a single enum shared by all users; one login/table serves ADMIN,
//   USER and STORE_OWNER (per the "single login system for all roles" rule).
// - Store.ownerId links a store to the STORE_OWNER user who manages it.
// - Rating has a composite unique constraint on (userId, storeId) so a user
//   can rate a given store only once; submitting again should be an UPDATE,
//   never a new row.
// - onDelete: Cascade on the foreign keys means deleting a user or store
//   cleans up their ratings automatically, avoiding orphaned rows.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
  STORE_OWNER
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  address   String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // A STORE_OWNER user may own one or more stores.
  ownedStores Store[]  @relation("StoreOwner")

  // Ratings this user (typically role USER) has submitted.
  ratings     Rating[]

  @@index([role])
  @@map("users")
}

model Store {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  address   String
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner   User     @relation("StoreOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  ratings Rating[]

  @@index([ownerId])
  @@map("stores")
}

model Rating {
  id        String   @id @default(uuid())
  userId    String
  storeId   String
  rating    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  // One user can rate one store only once — resubmission is an update.
  @@unique([userId, storeId])
  @@index([storeId])
  @@map("ratings")
}
